#!/bin/bash
# office-infra: perintah BACA-SAJA untuk diagnosis server. Dijalankan lewat sudo oleh bot Ops.
# Tidak menerima perintah bebas: hanya subperintah di bawah. Tidak ada docker inspect/logs/exec (bisa membocorkan variabel rahasia).
set -uo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
n="${2:-30}"; [[ "$n" =~ ^[0-9]{1,3}$ ]] && [ "$n" -le 100 ] || n=30
case "${1:-}" in
  tunnel)    echo "status: $(systemctl is-active cloudflared 2>&1)"; systemctl show cloudflared -p ActiveEnterTimestamp -p NRestarts --no-pager
             echo "--- $n baris log terakhir:"; journalctl -u cloudflared --no-pager -n "$n" 2>&1 | cut -c1-220 ;;
  kontainer) docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>&1 | head -40 ;;
  disk)      df -h / /var/lib/docker 2>/dev/null ;;
  memori)    free -h; echo; uptime ;;
  dns)       for h in region1.v2.argotunnel.com platform-socialhub.gennexbyte.com; do printf '%s -> ' "$h"; getent hosts "$h" | head -1 || echo GAGAL; done ;;
  *)         echo "perintah tidak dikenal. pilihan: tunnel [baris] | kontainer | disk | memori | dns"; exit 2 ;;
esac

# ===== Gennexbyte Office =====
# Salin ke .env lalu isi. Jangan commit .env.

# --- 9router (hanya model grup cx/) ---
ROUTER_BASE_URL=https://9router.zafirz.my.id/v1
ROUTER_API_KEY=
ROUTER_MODEL=cx/gpt-5.6-sol

# --- Server Office ---
OFFICE_PORT=4100
OFFICE_PUBLIC_URL=https://office.gennexbyte.com
# Token admin untuk dashboard (Anda & tim). Buat acak panjang.
OFFICE_ADMIN_TOKEN=

# --- Akses VM lain (isi bila agent perlu masuk ke VM tersebut) ---
# Satu blok per VM. Pakai kunci SSH, bukan password.
VM_NXBOOTH_HOST=
VM_NXBOOTH_USER=
VM_NXBOOTH_KEY_PATH=
VM_NXCHAT_HOST=
VM_NXCHAT_USER=
VM_NXCHAT_KEY_PATH=
VM_GENNEXBYTE_HOST=
VM_GENNEXBYTE_USER=
VM_GENNEXBYTE_KEY_PATH=

# --- SocialHub (agent Marketing menumpang di sini) ---
SOCIALHUB_API_URL=http://127.0.0.1:4000
SOCIALHUB_API_TOKEN=

# --- Database (Postgres lewat docker compose; dibuat otomatis di .env) ---
OFFICE_DB_PASSWORD=
DATABASE_URL=postgres://office:PASSWORD@127.0.0.1:5433/office

# Alamat bind server (0.0.0.0 = bisa dicapai tunnel lewat IP LAN)
OFFICE_HOST=0.0.0.0

# Lama tugas & hasil disimpan di papan tulis (hari), lalu dihapus otomatis
OFFICE_RETENTION_DAYS=5

# Patroli otomatis Ops (menit) dan daftar URL yang dipantau (pisahkan koma)
OPS_WATCH_MINUTES=180
OPS_URLS=https://platform-socialhub.gennexbyte.com

# --- Mesin Claude Code untuk bot (Engineer) ---
ENGINEER_SOCIALHUB_WORKDIR=
OFFICE_CLAUDE_DAILY_MAX=10
OFFICE_CLAUDE_TIMEOUT_MIN=10
OFFICE_APPROVAL_WAIT_H=24
OFFICE_WORKTREES=
OFFICE_GUEST_MODE=on
OFFICE_GUEST_NO_PREVIEW_ROOMS=finance,director

# Cadangan database otomatis (jika cadangan terakhir > 24 jam). Folder bawaan: ~/office-backups
OFFICE_BACKUP_KEEP=14

# --- Operator (asisten server serba bisa, pengganti SSH/Telegram) ---
# Folder kerja Operator; bawaan: home user service. Perubahan selalu lewat persetujuan di ruang Director.
OPERATOR_WORKDIR=

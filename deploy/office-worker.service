[Unit]
Description=Gennexbyte Office agent worker
After=office-api.service
Requires=office-api.service

[Service]
WorkingDirectory=%h/gennexbyteoffice
ExecStart=/home/gennexbyte/.nvm/versions/node/v22.23.3/bin/node --env-file=.env agents/worker.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
